{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redlighte",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-16",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
