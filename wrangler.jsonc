{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"redlighte",
  "main":"./worker/index.js",
  "compatibility_date":"2026-08-16",
  "observability":{"enabled":true,"traces":{"enabled":true}},
  "ai":{"binding":"AI"},
  "durable_objects":{"bindings":[{"name":"ROOMS","class_name":"RoomDurableObject"},{"name":"PRESENCE","class_name":"PresenceDurableObject"},{"name":"ROOM_INDEX","class_name":"RoomIndexDurableObject"}]},
  "migrations":[{"tag":"v1-room","new_sqlite_classes":["RoomDurableObject","PresenceDurableObject"]},{"tag":"v2-room-index","new_sqlite_classes":["RoomIndexDurableObject"]}],
  "assets":{"directory":".","binding":"ASSETS","run_worker_first":["/api/*"],"not_found_handling":"single-page-application"}
}
