{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "redlighte",
  "main": "_worker.js",
  "compatibility_date": "2026-08-16",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
